{
  "name": "php-baremetal-examples/button-events",
  "type": "project",
  "license": "proprietary",
  "description": "Event-driven: a button press arrives as an event and toggles an LED; no polling loop.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-events": "^1.0",
    "php-baremetal/ext-gpio": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "generic-esp32s3-quad",
      "runtime": "event-driven",
      "storage": "embedded"
    }
  }
}
