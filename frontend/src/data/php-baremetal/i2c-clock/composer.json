{
  "name": "php-baremetal-examples/i2c-clock",
  "type": "project",
  "license": "proprietary",
  "description": "I2C: scan the bus, then read the time from a DS3231 real-time clock every second.",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repository.php-baremetal.com",
      "canonical": true
    }
  ],
  "require": {
    "php-baremetal/conductor": "^1.0",
    "php-baremetal/ext-sys": "^1.0",
    "php-baremetal/ext-i2c": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "php-baremetal/conductor": true
    },
    "platform": {
      "php": "8.5.11"
    }
  },
  "extra": {
    "baremetal": {
      "sdk": "esp32@^2.0",
      "board": "generic-esp32s3-quad",
      "runtime": "init-loop",
      "storage": "embedded"
    }
  }
}
